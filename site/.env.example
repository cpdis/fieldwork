# Copy to .env.local for local dev. On Vercel, set these in Project settings > Environment Variables.

# Supabase Postgres. On Vercel use the transaction pooler string (port 6543), from
# Supabase > Connect > Transaction pooler. Locally, any Postgres works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fieldwork

# Public base URL, used in Stripe return links and emails.
SITE_URL=http://localhost:3000

# Stripe TEST mode keys until the Australian account is live. A live key is refused
# in production unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ALLOW_LIVE=1

# Admin sign-in. Use a long random password and a separate random secret (openssl rand -base64 32).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Resend. Leave RESEND_API_KEY blank to print emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Fieldwork <hello@example.com>"
EMAIL_REPLY_TO=
# Optional link in the follow-up email.
FEEDBACK_URL=

# Vercel Cron sends this as a bearer token to /api/cron/emails.
CRON_SECRET=
